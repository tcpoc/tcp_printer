# dry-run keeps jobs local for UI testing. Set cups on the Ubuntu Mini PC.
TCP_PRINTER_MODE=dry-run
TCP_PRINTER_QUEUE=CP1025
TCP_PRINTER_HOST=0.0.0.0
TCP_PRINTER_PORT=8080
# Keep false on the Mini PC. Set true only while editing code locally.
TCP_PRINTER_RELOAD=false
# The user-facing page does not show this limit. Raise it only when the Mini PC has enough storage.
TCP_PRINTER_MAX_UPLOAD_MB=200
# Time to wait for CUPS to finish before reporting a clear printer error.
TCP_PRINTER_CUPS_WAIT_SECONDS=900
# Uploaded files and finished jobs are automatically removed after this many hours.
TCP_PRINTER_RETENTION_HOURS=24
# Optional administrator token. Leave empty to disable the admin dashboard.
TCP_PRINTER_ADMIN_TOKEN=

# Optional CUPS color option. Confirm it with: lpoptions -p CP1025 -l
TCP_PRINTER_COLOR_OPTION=print-color-mode
TCP_PRINTER_COLOR_MONO=monochrome
TCP_PRINTER_COLOR_COLOR=color
